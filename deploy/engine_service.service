[Unit]
Description=AMW A1 - Position Monitoring (SL/Target/EOD), Dashboard पासून स्वतंत्र
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# 🎓 वापरकर्त्याशी चर्चा करून जोडलेली सुधारणा — WorkingDirectory आणि python3 चा पूर्ण मार्ग तुमच्या
# droplet वरच्या actual paths प्रमाणे बदला (उदा. जर virtualenv वापरत असाल तर तिथला python3).
WorkingDirectory=/root/amw_a1_trading_system
ExecStart=/usr/bin/python3 /root/amw_a1_trading_system/engine_service.py
# 🎓 SUPABASE_DB_URL / TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID — इथे थेट न लिहिता वेगळ्या env file मध्ये
# ठेवा (खाली EnvironmentFile), जेणेकरून हा unit file git मध्ये commit केला तरी secrets लीक होणार नाहीत.
EnvironmentFile=/root/amw_a1_trading_system/.env
