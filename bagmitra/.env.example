# Copy to api/.env for local development. Never commit real values.
ENVIRONMENT=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54322/bagmitra
# Supabase project settings → API → JWT secret (>= 32 chars)
SUPABASE_JWT_SECRET=
CORS_ORIGINS=["http://localhost:8080"]
# Optional error reporting (requires sentry-sdk installed)
SENTRY_DSN=
