{
  "components": {
    "schemas": {
      "Change": {
        "properties": {
          "data": {
            "additionalProperties": true,
            "title": "Data",
            "type": "object"
          },
          "entity": {
            "title": "Entity",
            "type": "string"
          },
          "entity_id": {
            "title": "Entity Id",
            "type": "string"
          },
          "op": {
            "enum": [
              "upsert",
              "delete"
            ],
            "title": "Op",
            "type": "string"
          },
          "seq": {
            "title": "Seq",
            "type": "integer"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "entity",
          "entity_id",
          "op",
          "data",
          "updated_at",
          "seq"
        ],
        "title": "Change",
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "FarmerProfile": {
        "properties": {
          "consent_data_processing": {
            "title": "Consent Data Processing",
            "type": "boolean"
          },
          "consent_whatsapp": {
            "title": "Consent Whatsapp",
            "type": "boolean"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "district": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "District"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "language": {
            "title": "Language",
            "type": "string"
          },
          "phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone"
          },
          "taluka": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Taluka"
          },
          "village": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Village"
          }
        },
        "required": [
          "id",
          "phone",
          "display_name",
          "language",
          "village",
          "taluka",
          "district",
          "consent_data_processing",
          "consent_whatsapp"
        ],
        "title": "FarmerProfile",
        "type": "object"
      },
      "LiveResponse": {
        "properties": {
          "product": {
            "title": "Product",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "product"
        ],
        "title": "LiveResponse",
        "type": "object"
      },
      "Mutation": {
        "properties": {
          "client_mutation_id": {
            "format": "uuid",
            "title": "Client Mutation Id",
            "type": "string"
          },
          "client_updated_at": {
            "format": "date-time",
            "title": "Client Updated At",
            "type": "string"
          },
          "entity": {
            "maxLength": 64,
            "title": "Entity",
            "type": "string"
          },
          "entity_id": {
            "maxLength": 64,
            "title": "Entity Id",
            "type": "string"
          },
          "op": {
            "enum": [
              "upsert",
              "delete"
            ],
            "title": "Op",
            "type": "string"
          },
          "payload": {
            "additionalProperties": true,
            "title": "Payload",
            "type": "object"
          }
        },
        "required": [
          "client_mutation_id",
          "entity",
          "entity_id",
          "op",
          "client_updated_at",
          "payload"
        ],
        "title": "Mutation",
        "type": "object"
      },
      "MutationResult": {
        "properties": {
          "client_mutation_id": {
            "format": "uuid",
            "title": "Client Mutation Id",
            "type": "string"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "status": {
            "enum": [
              "applied",
              "duplicate",
              "stale",
              "rejected"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "client_mutation_id",
          "status"
        ],
        "title": "MutationResult",
        "type": "object"
      },
      "PullResponse": {
        "properties": {
          "changes": {
            "items": {
              "$ref": "#/components/schemas/Change"
            },
            "title": "Changes",
            "type": "array"
          },
          "cursor": {
            "title": "Cursor",
            "type": "integer"
          }
        },
        "required": [
          "changes",
          "cursor"
        ],
        "title": "PullResponse",
        "type": "object"
      },
      "PushRequest": {
        "properties": {
          "mutations": {
            "items": {
              "$ref": "#/components/schemas/Mutation"
            },
            "minItems": 1,
            "title": "Mutations",
            "type": "array"
          }
        },
        "required": [
          "mutations"
        ],
        "title": "PushRequest",
        "type": "object"
      },
      "PushResponse": {
        "properties": {
          "results": {
            "items": {
              "$ref": "#/components/schemas/MutationResult"
            },
            "title": "Results",
            "type": "array"
          }
        },
        "required": [
          "results"
        ],
        "title": "PushResponse",
        "type": "object"
      },
      "ReadyResponse": {
        "properties": {
          "database": {
            "title": "Database",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "database"
        ],
        "title": "ReadyResponse",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "BagMitra API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "health_live",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "health_ready",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Ready",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/me": {
      "get": {
        "operationId": "me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FarmerProfile"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Me",
        "tags": [
          "profile"
        ]
      }
    },
    "/v1/sync/pull": {
      "get": {
        "operationId": "sync_pull",
        "parameters": [
          {
            "in": "query",
            "name": "since",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Since",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PullResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Pull",
        "tags": [
          "sync"
        ]
      }
    },
    "/v1/sync/push": {
      "post": {
        "description": "Apply a batch of offline mutations. Each mutation gets its own result; the batch\nnever fails as a whole because of one bad mutation.",
        "operationId": "sync_push",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PushRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PushResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Push",
        "tags": [
          "sync"
        ]
      }
    }
  }
}
